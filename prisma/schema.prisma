// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Deliberately the classic generator with its default node_modules output,
// not the newer "prisma-client" generator with a custom `output` path: that
// combination bakes the build machine's absolute filesystem path into the
// compiled engine-lookup logic (confirmed from the actual bundled chunk in
// production), which breaks the moment the deploy environment's filesystem
// layout differs from the one that ran `prisma generate` — regardless of
// which machine that build happens on. This default layout is the one
// Next.js has first-class, externalized support for.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  fr
  es
  pt
}

enum TaskType {
  TASK_1
  TASK_2
  TASK_3
}

enum TopicSource {
  OFFICIAL_EXAM
  RECENT_EXAM
  AI_GENERATED
  USER_SUBMITTED
}

enum EssayStatus {
  DRAFT
  SUBMITTED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELED
  UNPAID
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Legacy bcrypt hashes remain only for the Clerk import/cutover. New
  // Clerk users (including Google sign-ins) have no app-managed password.
  passwordHash  String?
  name          String?
  locale        Locale   @default(en)
  // Additive Clerk identity mapping. Nullable until each existing learner is
  // imported into Clerk; every essay/subscription/quota FK keeps pointing at
  // `id` (the CUID), never at this Clerk subject, so no foreign key needs to
  // be rewritten as part of the Clerk cutover.
  clerkUserId   String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  essays        Essay[]
  translationQuota TranslationQuota?
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A customer can hold more than one subscription over time (or, in
  // principle, concurrently), so this is the indexed lookup key, not the
  // unique identity of the row — that's stripeSubscriptionId.
  stripeCustomerId     String
  stripeSubscriptionId String              @unique
  stripePriceId        String?
  status               SubscriptionStatus  @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  // Informational only — the last Stripe event's timestamp applied to this
  // row. Writes are serialized per-subscription (see the webhook handler),
  // so this is not used to gate whether a write is applied.
  lastStripeEventAt    DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

/// Durable record of processed Stripe webhook events, keyed by Stripe's own
/// event ID, so a redelivered event (Stripe explicitly does not guarantee
/// exactly-once or in-order delivery) is a no-op instead of reapplied.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Topic {
  id          String      @id @default(cuid())
  taskType    TaskType
  title       String
  prompt      String
  source      TopicSource @default(USER_SUBMITTED)
  // Provenance for a server-fetched prompt. Both fields stay null for the
  // existing seeded and learner-supplied topics.
  sourceUrl   String?
  // This includes a content hash so revised upstream prompts produce a new,
  // immutable Topic rather than mutating the context of saved essays.
  externalRef String?     @unique
  // Populated only for AI_GENERATED Task 3 topics: a generated illustrative
  // photo stored as a self-contained data URL (no external blob storage, and
  // no expiring provider-hosted URL to keep re-resolving). Null for every
  // other topic and for a generated topic whose image call failed or was
  // skipped, since a missing illustration must never block topic generation.
  imageData   String?
  // French, generated alongside the image so it stays specific to that
  // topic's illustration; required whenever imageData is set.
  imageAlt    String?
  createdAt   DateTime    @default(now())

  essays    Essay[]

  @@index([taskType])
}

model Essay {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  taskType    TaskType
  content     String
  wordCount   Int         @default(0)
  status      EssayStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  feedback    Feedback?

  @@index([userId])
  @@index([topicId])
}

model Feedback {
  id                String    @id @default(cuid())
  essayId           String    @unique
  essay             Essay     @relation(fields: [essayId], references: [id], onDelete: Cascade)
  level             CefrLevel?
  summary           String
  grammarNotes      Json?
  suggestions       Json?
  translatedText    String?
  meetsWordCount    Boolean   @default(false)
  createdAt         DateTime  @default(now())
}

/// A durable, per-learner quota reservation for live Google translations.
/// The route updates this row inside a PostgreSQL transaction advisory lock,
/// so concurrent requests from separate server instances cannot both spend
/// the same minute or month allowance.
model TranslationQuota {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minuteStartedAt      DateTime
  minuteRequestCount   Int      @default(0)
  minuteCharacterCount Int      @default(0)
  monthStartedAt       DateTime
  monthCharacterCount  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A durable, project-wide circuit breaker for the unofficial translation
/// scraper fallback. Unlike TranslationQuota (per learner), this is a single
/// fixed-id row: repeated scraper failures (e.g. an upstream IP block) should
/// stop every learner's requests from retrying a broken endpoint, not just
/// one learner's.
model TranslationFallbackCircuit {
  id                  String    @id
  consecutiveFailures Int       @default(0)
  openUntil           DateTime?
  updatedAt           DateTime  @updatedAt
}

/// Clerk webhooks are delivered at least once. Recording their Svix IDs keeps
/// side effects idempotent and intentionally does not cascade Clerk account
/// deletion into the learner's essays, quotas, or subscriptions.
model ClerkWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
