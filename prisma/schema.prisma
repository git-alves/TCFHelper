// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Deliberately the classic generator with its default node_modules output,
// not the newer "prisma-client" generator with a custom `output` path: that
// combination bakes the build machine's absolute filesystem path into the
// compiled engine-lookup logic (confirmed from the actual bundled chunk in
// production), which breaks the moment the deploy environment's filesystem
// layout differs from the one that ran `prisma generate` — regardless of
// which machine that build happens on. This default layout is the one
// Next.js has first-class, externalized support for.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  fr
  es
  pt
}

enum TaskType {
  TASK_1
  TASK_2
  TASK_3
}

enum TopicSource {
  OFFICIAL_EXAM
  RECENT_EXAM
  AI_GENERATED
  USER_SUBMITTED
}

// The writing situation (audience/register/genre/purpose) a guided-writing
// tip set is chosen for -- see docs/guided-writing.md. Deliberately narrower
// than a free-form register flag: genre changes the expected structure as
// well as the greeting, so "formal" alone isn't enough to pick a Start tip.
enum GuideProfile {
  INFORMAL_PERSONAL_MESSAGE
  FORMAL_PROFESSIONAL_MESSAGE
  PUBLIC_ARTICLE_OR_NOTE
  PUBLIC_LETTER
  ARGUMENTATIVE_ANALYSIS
}

enum EssayStatus {
  DRAFT
  SUBMITTED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// The target level of a curated Practice sequence. This is intentionally
// separate from the assessment-oriented CefrLevel enum: a learner can train
// a C1 sequence before any correction has established (or even estimated)
// their current level.
enum PracticeLevel {
  B2
  C1
  C2
}

// A completion records how the learner resolved a fixed exercise. Revealing
// an answer remains a valid completed activity, but stays distinct from an
// independent response in Dashboard reporting.
enum PracticeCompletionMethod {
  CORRECT
  SELF_REVIEW
  REVEALED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELED
  UNPAID
}

/// The subject chosen by a learner when contacting support. Kept as a closed
/// database enum so support triage does not depend on browser-provided labels.
enum SupportRequestCategory {
  BUG
  QUESTION
  FEATURE_REQUEST_FEEDBACK
  ACCOUNT_ACCESS
  OTHER
}

model User {
  id                          String    @id @default(cuid())
  email                       String    @unique
  // Legacy bcrypt hashes remain only for the Clerk import/cutover. New
  // Clerk users (including Google sign-ins) have no app-managed password.
  passwordHash                String?
  name                        String?
  locale                      Locale    @default(en)
  // Additive Clerk identity mapping. Nullable until each existing learner is
  // imported into Clerk; every essay/subscription/quota FK keeps pointing at
  // `id` (the CUID), never at this Clerk subject, so no foreign key needs to
  // be rewritten as part of the Clerk cutover.
  clerkUserId                 String?   @unique
  // There is deliberately no self-service role assignment. The single owner
  // account is promoted through an operational database change.
  isAdmin                     Boolean   @default(false)
  // Blocked accounts resolve as unauthenticated at the application boundary
  // so every existing protected page and API route denies access uniformly.
  isBlocked                   Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  // Null means this learner has never completed or skipped a walkthrough.
  // Compared against the app's CURRENT_WALKTHROUGH_VERSION constant to
  // decide whether to auto-start it -- bumping that constant re-shows a
  // revised tour to everyone below the new version, with no new migration.
  // Existing accounts are classified at rollout by a separate,
  // explicitly-approved maintenance backfill. It is never automatic because
  // the recorded pre-gate cohort, rather than a later null-value guess,
  // determines who is established for this onboarding release.
  walkthroughCompletedVersion Int?
  // Set atomically with the first successful access-code redemption. It keeps
  // the welcome handoff one-time even if the owner later deactivates access
  // and the learner redeems a newly issued code.
  activationWelcomeShownAt    DateTime?
  // Presence for the admin "online now" count. Updated (throttled -- see
  // ACTIVITY_HEARTBEAT_THROTTLE_MS in app-user.ts) whenever an already-linked,
  // non-blocked account resolves a request. Null means never observed active.
  // There is no background job or push channel; the admin overview treats
  // "active within the last couple of minutes" as online, so this is a
  // heartbeat, not literal real-time presence.
  lastActiveAt                DateTime?

  subscriptions           Subscription[]
  essays                  Essay[]
  exampleAnswers          ExampleAnswer[]
  exampleGenerationQuota  ExampleGenerationQuota?
  exampleGenerationLeases ExampleGenerationLease[]
  correctionLeases        CorrectionLease[]
  correctionUsage         CorrectionUsage?
  practiceSessions        PracticeSession[]
  translationQuota        TranslationQuota?
  quotaOverride           UserQuotaOverride?
  redeemedAccessCodes     AccessCode[]             @relation("AccessCodeRedeemedBy")
  supportRequests         SupportRequest[]

  @@index([lastActiveAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A customer can hold more than one subscription over time (or, in
  // principle, concurrently), so this is the indexed lookup key, not the
  // unique identity of the row — that's stripeSubscriptionId.
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // Informational only — the last Stripe event's timestamp applied to this
  // row. Writes are serialized per-subscription (see the webhook handler),
  // so this is not used to gate whether a write is applied.
  lastStripeEventAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

/// Durable record of processed Stripe webhook events, keyed by Stripe's own
/// event ID, so a redelivered event (Stripe explicitly does not guarantee
/// exactly-once or in-order delivery) is a no-op instead of reapplied.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Topic {
  id           String        @id @default(cuid())
  taskType     TaskType
  title        String
  prompt       String
  source       TopicSource   @default(USER_SUBMITTED)
  // Provenance for a server-fetched prompt. Both fields stay null for the
  // existing seeded and learner-supplied topics.
  sourceUrl    String?
  // This includes a content hash so revised upstream prompts produce a new,
  // immutable Topic rather than mutating the context of saved essays.
  externalRef  String?       @unique
  createdAt    DateTime      @default(now())
  // Set when a managed OFFICIAL_EXAM starter topic's prompt text is
  // corrected: the existing row is retired (this timestamp set) rather than
  // its prompt mutated in place, and a new row with the corrected prompt is
  // created alongside it -- see seed-topic-sync.ts. A plain additive,
  // nullable column rather than a new TopicSource value on purpose: old code
  // still running during a rolling deploy never reads this field, so it
  // keeps accepting a freshly-retired row exactly as before (source is
  // untouched) instead of rejecting it as an unrecognized enum value until
  // traffic has fully cut over to the new deployment. Only the topic
  // picker (retiredAt: null) and the seed sync's own "find the current
  // version" lookup filter on it.
  retiredAt    DateTime?
  // Editorially assigned writing-context profile for the guided-writing
  // feature (see docs/guided-writing.md). Nullable and additive: existing
  // rows and recent-exam/custom topics that have no curated profile fall
  // back to the client-side deterministic classifier instead of this field.
  guideContext GuideProfile?

  essays Essay[]

  @@index([taskType])
}

model Essay {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId           String?
  topic             Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  taskType          TaskType
  content           String
  // This is a SHA-256 of the normalized task/topic/content correction key,
  // not merely the text. Nullable keeps the additive rollout compatible with
  // essays written by the still-live previous app version; the claim layer
  // falls back to exact legacy content/context matching for those rows.
  correctionKeyHash String?
  wordCount         Int         @default(0)
  status            EssayStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  feedback Feedback?

  @@unique([userId, correctionKeyHash])
  @@index([userId])
  @@index([topicId])
}

model Feedback {
  id             String     @id @default(cuid())
  essayId        String     @unique
  essay          Essay      @relation(fields: [essayId], references: [id], onDelete: Cascade)
  level          CefrLevel?
  // Feedback prose follows the interface locale used for the correction.
  // Keeping it lets a saved review remain accurately labelled after a learner
  // changes their interface language.
  feedbackLocale Locale?
  summary        String
  grammarNotes   Json?
  suggestions    Json?
  translatedText String?
  meetsWordCount Boolean    @default(false)
  createdAt      DateTime   @default(now())
}

/// A learner's run through one reviewed, six-stage Practice sequence. The
/// selected exercise IDs are stored as a snapshot because a stage can have
/// several editorial variants; completion writes are accepted only for this
/// server-validated set, never for arbitrary browser-supplied IDs.
model PracticeSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType    TaskType
  targetLevel PracticeLevel
  skillId     String
  exerciseIds Json
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  completions PracticeExerciseCompletion[]

  @@index([userId, completedAt])
  @@index([userId, taskType, targetLevel, skillId])
}

/// One resolved exercise in a PracticeSession. The composite unique key makes
/// retries and duplicate browser requests idempotent without overwriting the
/// first recorded completion method.
model PracticeExerciseCompletion {
  id               String                   @id @default(cuid())
  sessionId        String
  session          PracticeSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exerciseType     String
  completionMethod PracticeCompletionMethod
  completedAt      DateTime                 @default(now())

  @@unique([sessionId, exerciseId])
  @@index([completedAt])
}

/// A short-lived, per-learner claim protects a provider call after its
/// claiming transaction commits. A matching completed Essay is the durable
/// result; this row exists only while a request is in progress.
model CorrectionLease {
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  correctionKeyHash String
  claimToken        String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@id([userId, correctionKeyHash])
  @@index([expiresAt])
}

/// Durable correction usage. Unlike CorrectionLease, which is only an
/// in-flight deduplication lock, this remains after a provider-call slot is
/// claimed so limits and admin reporting can use the same rolling-window
/// pattern as translation and example generation.
model CorrectionUsage {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayStartedAt        DateTime
  dailyRequestCount   Int      @default(0)
  monthStartedAt      DateTime
  monthlyRequestCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Nullable limits override only the specified global default. Keeping every
/// metric nullable lets an owner adjust one abuse-control dimension without
/// accidentally pinning the rest when product-wide defaults later change.
model UserQuotaOverride {
  userId                         String   @id
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationRequestsPerMinute   Int?
  translationCharactersPerMinute Int?
  translationCharactersPerMonth  Int?
  exampleGenerationsPerDay       Int?
  correctionRequestsPerDay       Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

/// A code activates exactly one learner account. A unique redeemedByUserId
/// makes activation idempotent and prevents a single account from consuming
/// an extra code while it is admitted. An owner may later detach that live
/// admission without clearing redeemedAt, so the code remains permanently
/// spent and the learner must use a newly issued code.
model AccessCode {
  id               String    @id @default(cuid())
  code             String    @unique
  note             String?
  createdAt        DateTime  @default(now())
  redeemedAt       DateTime?
  redeemedByUserId String?   @unique
  redeemedByUser   User?     @relation("AccessCodeRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  // Null means lifetime access. Otherwise, the learner's admission expires
  // this many days after redeemedAt (not after createdAt) -- an unredeemed
  // timed code does not itself expire. There is no background job, so
  // expiry is detected and enforced lazily, the same way a manual
  // "Deactivate access" is: on the learner's next request after the window
  // elapses. A CHECK constraint (added in the same migration, since Prisma's
  // schema language cannot express one) bounds this to
  // MAX_VALIDITY_DAYS in src/lib/access-code-limits.ts.
  validityDays     Int?
  // Denormalized at redemption time (redeemedAt + validityDays), not
  // recomputed on every read: it is what lets an ordinary Prisma query
  // (e.g. the admin users list's Activated/Unactivated filter) compare a
  // learner's live-admission expiry directly, in one bounded, consistent
  // query, instead of loading every redeemed code into application memory
  // to do that date arithmetic by hand. Null means either "lifetime code"
  // or "not yet redeemed" -- ambiguity that call sites resolve the same way
  // resolveAdmissionLocked always has, by first checking whether the code
  // is even currently redeemed. Left untouched (not cleared) once a code is
  // detached, matching redeemedAt's own "durable historical marker"
  // behavior -- see resetAccessCodeActivation.
  expiresAt        DateTime?

  @@index([redeemedAt])
  // Matches getAdminAccessCodesPage's orderBy([{createdAt: "desc"}, {id: "desc"}])
  // + skip/take exactly, so the admin list stays a fast index scan instead of
  // an in-memory sort as the code inventory grows.
  @@index([createdAt, id])
}

/// Owner-only operational events. This is deliberately a structured ledger,
/// not a free-form application-log mirror: every persisted field is selected
/// from a closed server-side registry and checked by the additive SQL
/// migration so prompts, bearer credentials, raw provider errors, and request
/// metadata cannot enter the admin dashboard.
///
/// `occurredAt` is the most recent observation. Noisy events may be safely
/// coalesced through `dedupeKey`, with `occurrenceCount` preserving that they
/// repeated. Rows intentionally do not use foreign keys: a short-retention
/// event remains interpretable after its user, essay, or access code has been
/// deleted, and the event table never changes product ownership semantics.
model AdminEvent {
  id                    String   @id @default(cuid())
  occurredAt            DateTime @default(now())
  firstOccurredAt       DateTime @default(now())
  severity              String
  module                String
  eventType             String
  searchText            String
  userId                String?
  essayId               String?
  accessCodeId          String?
  provider              String?
  reasonCode            String?
  httpStatus            Int?
  quotaWindow           String?
  usageValue            Int?
  quotaLimit            Int?
  // Authentication events expose only a vetted display mask and closed
  // browser/device labels. The full, HMACed network/session identifiers stay
  // in AuthSecuritySession and are never selected for the owner UI.
  maskedIp              String?
  browserFamily         String?
  deviceClass           String?
  distinctIpCount       Int?
  securityWindowMinutes Int?
  occurrenceCount       Int      @default(1)
  dedupeKey             String?  @unique

  @@index([occurredAt, id])
  @@index([severity, occurredAt, id])
  @@index([module, occurredAt, id])
  @@index([userId, occurredAt, id])
  @@index([essayId, occurredAt, id])
  @@index([userId, eventType, occurredAt, id])
}

/// Private, short-lived inputs for review-only sign-in anomaly detection.
/// This relation-free table has no raw IP, user agent, Clerk session/client
/// ID, location, or copied identity data. Both fingerprints are HMAC values
/// with a version prefix and are never selected into an owner-facing response.
/// Rows expire with AdminEvent after 30 days.
model AuthSecuritySession {
  id                   String    @id @default(cuid())
  userId               String
  occurredAt           DateTime
  sessionFingerprint   String    @unique
  ipFingerprint        String?
  alertBucketStartedAt DateTime?
  createdAt            DateTime  @default(now())

  @@unique([userId, alertBucketStartedAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
}

/// A cached model answer is private to its learner. The hash avoids storing a
/// custom prompt a second time while making repeat requests free of provider
/// usage.
model ExampleAnswer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType  TaskType
  level     String
  topicHash String
  content   String
  provider  String
  createdAt DateTime @default(now())

  @@unique([userId, taskType, level, topicHash])
  @@index([userId])
}

/// Limits fresh provider calls, while cache hits stay free. The route holds a
/// transaction-scoped per-user lock before updating this row.
model ExampleGenerationQuota {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayStartedAt      DateTime
  dailyRequestCount Int       @default(0)
  // Refunding a failed attempt (see ExampleGenerationLease) means the daily
  // count alone no longer bounds how often a persistently failing provider
  // can be called — every failure is refunded, so the count never climbs.
  // This short, separate cooldown between attempts (successful or not)
  // caps that call rate without limiting genuinely successful usage.
  lastAttemptAt     DateTime?
  // Counts every claimed attempt for the day, successful or not, and is
  // never decremented on refund (unlike dailyRequestCount) — it exists
  // specifically so a persistently failing provider cannot be hammered an
  // unbounded number of times per day just because every failure refunds
  // dailyRequestCount back to zero. The cooldown above only limits burst
  // rate; this is the durable per-day cap.
  dailyAttemptCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// A short-lived claim for a single model-answer cache key. It keeps rapid
/// double-clicks or concurrent tabs from reserving two provider calls while
/// the first response is still being generated.
model ExampleGenerationLease {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType     TaskType
  level        String
  topicHash    String
  claimToken   String
  // The exact UTC day this reservation's slot was counted against. A
  // refund must read this back rather than compute "today" itself, since a
  // request that straddles UTC midnight would otherwise refund the wrong
  // day's count. The default is a genuine UTC-midnight value, kept
  // permanently (not dropped after backfill) so a lease row written by a
  // still-live previous app version during an additive-migration rollout
  // — which does not know about this column — stays correct rather than
  // merely satisfying NOT NULL.
  dayStartedAt DateTime @default(dbgenerated("date_trunc('day', now() AT TIME ZONE 'UTC')"))
  expiresAt    DateTime

  @@id([userId, taskType, level, topicHash])
  @@index([expiresAt])
}

/// A durable, per-learner quota reservation for live Google translations.
/// The route updates this row inside a PostgreSQL transaction advisory lock,
/// so concurrent requests from separate server instances cannot both spend
/// the same minute or month allowance.
model TranslationQuota {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minuteStartedAt      DateTime
  minuteRequestCount   Int      @default(0)
  minuteCharacterCount Int      @default(0)
  monthStartedAt       DateTime
  monthCharacterCount  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A durable, project-wide circuit breaker for the unofficial translation
/// scraper fallback. Unlike TranslationQuota (per learner), this is a single
/// fixed-id row: repeated scraper failures (e.g. an upstream IP block) should
/// stop every learner's requests from retrying a broken endpoint, not just
/// one learner's.
model TranslationFallbackCircuit {
  id                  String    @id
  consecutiveFailures Int       @default(0)
  openUntil           DateTime?
  updatedAt           DateTime  @updatedAt
}

/// Clerk webhooks are delivered at least once. Recording their Svix IDs keeps
/// side effects idempotent and intentionally does not cascade Clerk account
/// deletion into the learner's essays, quotas, or subscriptions.
model ClerkWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Single fixed-id row (the app only ever reads/writes id "singleton").
/// Lets the owner override the Gemini API key and model used for correction
/// and for example generation independently, from the admin panel, without
/// an env var change and redeploy. Any null field falls back to the
/// GEMINI_API_KEY / GEMINI_MODEL / GEMINI_CORRECTION_MODEL env vars (see
/// src/lib/app-config.ts and src/lib/gemini.ts). Stored in plaintext: this
/// table is reachable only through the owner-only admin API, matching the
/// app's single-owner threat model (see User.isAdmin above) rather than
/// introducing separate encryption-key management for a single admin field.
model AppConfig {
  id                   String   @id @default("singleton")
  correctionApiKey     String?
  correctionModel      String?
  exampleApiKey        String?
  exampleModel         String?
  // Admin-editable reference point for the settings-page consumption bar
  // only (src/lib/app-config.ts) -- an approximate daily Gemini request
  // count against a limit the owner sets, not an enforced quota. Null uses
  // DEFAULT_GEMINI_DAILY_REQUEST_LIMIT.
  correctionDailyLimit Int?
  exampleDailyLimit    Int?
  updatedAt            DateTime @updatedAt
}

/// A learner-authored support message. senderEmail is intentionally a
/// submission-time snapshot: the owner can answer the address the learner saw
/// in "Send as", even if the account profile changes before triage.
model SupportRequest {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail String
  category    SupportRequestCategory
  details     String
  createdAt   DateTime               @default(now())
  // Set once the request has been fully mirrored to HubSpot (ticket, contact
  // association, and attachment note if any). Null means either sync hasn't
  // run yet, HubSpot isn't configured, or every attempt so far has failed --
  // the local row is always the source of truth, so a missing mirror never
  // blocks anything the learner or admin does here. The retry cron
  // (/api/cron/hubspot-support-sync-retry) re-attempts rows where this is
  // still null.
  hubspotTicketId String?
  // Set once the ticket's attachment note has been created, independently of
  // hubspotSyncedAt, so a retry after a failure elsewhere in the sync never
  // re-uploads the file or creates a duplicate note.
  hubspotAttachmentSyncedAt DateTime?
  hubspotSyncedAt           DateTime?
  hubspotSyncAttempts       Int        @default(0)
  hubspotLastSyncError      String?

  attachment SupportAttachment?

  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([hubspotSyncedAt, hubspotSyncAttempts])
}

/// A single optional evidence file for a support request. Keeping it private
/// and as an attachment (not a public URL) prevents an upload from becoming a
/// newly exposed hosting surface. A future owner-only download route can
/// stream this as Content-Disposition: attachment.
model SupportAttachment {
  id               String         @id @default(cuid())
  supportRequestId String         @unique
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  originalName     String
  mimeType         String
  byteSize         Int
  data             Bytes
  createdAt        DateTime       @default(now())
}
