{
  "name": "tcfhelper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify:prisma-engine": "node scripts/verify-prisma-engine.mjs .next/server",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:additive": "tsx scripts/deploy-additive-migrations.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-topics.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "clerk:import": "tsx scripts/import-users-to-clerk.ts",
    "vercel-build": "prisma generate && npm run db:deploy:additive && npm run build && npm run verify:prisma-engine"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^3.15.0",
    "@clerk/localizations": "^4.13.10",
    "@clerk/nextjs": "^7.6.4",
    "@prisma/client": "^6.19.3",
    "@vitalets/google-translate-api": "^9.2.1",
    "cheerio": "^1.2.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
