# Copy this file to .env and fill in real values for local development.
# In Vercel, set these as project Environment Variables instead.

# Postgres connection string (e.g. from Vercel Postgres, Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/mytcflab?schema=public"

# Clerk — retrieve both keys from the Clerk dashboard. The publishable key is
# safe for the browser; the secret key is server-only and also used by
# `npm run clerk:import` for the one-time legacy-user import.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Create a Clerk Dashboard webhook for /api/webhooks/clerk (user.created and
# user.updated), then copy its signing secret here.
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Google Gemini generates both writing corrections and model answers. Its API
# key is available from aistudio.google.com/apikey.
GEMINI_API_KEY=""
# Model used for generated study examples. It is intentionally separate from
# the correction model below.
GEMINI_MODEL=""

# Model used only for writing correction. Defaults to a Flash-Lite model and
# remains separate from GEMINI_MODEL so grading never implicitly shares the
# model-answer generator's choice. Current options as of this writing:
# gemini-2.5-flash-lite, gemini-3.5-flash-lite (both support structured
# output) -- check https://ai.google.dev/gemini-api/docs/models for the
# current lineup, since free-tier model names are retired over time.
GEMINI_CORRECTION_MODEL=""

# DeepL API Free — used server-side for live draft translation. Get a key at
# deepl.com/pro-api (keys end in ":fx"). Optional: if unset, or once its
# 500,000-character monthly quota is reached, translation falls back to an
# unofficial method — see "Live translation" in README.md.
DEEPL_API_KEY=""

# Stripe — from the Stripe dashboard (test mode keys for local dev)
STRIPE_SECRET_KEY=""
# Set after running `npm run stripe:setup` or creating a webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=""
# Set after running `npm run stripe:setup`
STRIPE_PRICE_ID=""

# Public base URL of the app, used for links and Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
