# Copy this file to .env and fill in real values for local development.
# In Vercel, set these as project Environment Variables instead.

# Postgres connection string (e.g. from Vercel Postgres, Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tcfhelper?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the deployment, used by NextAuth for callbacks
NEXTAUTH_URL="http://localhost:3000"

# Anthropic — used to generate writing feedback. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=""

# DeepL API Free — used server-side for live draft translation. Get a key at
# deepl.com/pro-api (keys end in ":fx"). Optional: if unset, or once its
# 500,000-character monthly quota is reached, translation falls back to an
# unofficial method — see "Live translation" in README.md.
DEEPL_API_KEY=""

# Stripe — from the Stripe dashboard (test mode keys for local dev)
STRIPE_SECRET_KEY=""
# Set after running `npm run stripe:setup` or creating a webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=""
# Set after running `npm run stripe:setup`
STRIPE_PRICE_ID=""

# Public base URL of the app, used for links and Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
